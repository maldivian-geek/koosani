# Production image for api/worker — multi-stage build. Compiles TS to JS and
# runs the compiled output directly with node (unlike api/Dockerfile, the dev
# container, which runs `tsx watch` against the TS sources). Shared by both
# the `api` and `worker` services in docker-compose.prod.yml — same image,
# different command. Build context is the repo root (pnpm workspace requires
# the full monorepo to resolve `workspace:*` deps).
# Pin the exact pnpm version (matches root package.json's "packageManager")
# via `corepack prepare --activate` rather than plain `corepack enable`, in
# both stages — the latter lazily downloads whatever pnpm version corepack
# resolves at first invocation, which for the runtime stage means a network
# fetch on the container's first cold start (fragile — no network access
# expected/needed at container runtime) and, in general, an unpinned/
# unreproducible pnpm version build-to-build.
FROM node:22 AS build

WORKDIR /repo
RUN corepack enable && corepack prepare pnpm@11.4.0 --activate

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY api/package.json ./api/package.json
COPY web/package.json ./web/package.json
COPY portal/package.json ./portal/package.json
COPY shared/package.json ./shared/package.json

# Resource caps for the build stage — this runs on the same host as every
# other deployed app, not a dedicated build machine, so an unbounded
# tsc/esbuild/pnpm-install memory or CPU spike here can starve everything
# else on the box (this took the whole server down once already). Lower
# network concurrency to reduce peak parallel download/extract load; cap
# Node's heap so a runaway compile OOMs its own container instead of the host.
ENV NODE_OPTIONS=--max-old-space-size=768
RUN pnpm install --frozen-lockfile --network-concurrency=4

COPY shared ./shared
COPY api ./api

# Not `pnpm --filter @koosani/shared build` (plain `tsc -p`) — composite
# project references need `-b --force` for a from-scratch build or the
# downstream api build can't reliably resolve shared's declaration output.
RUN cd shared && pnpm exec tsc -b --force
RUN pnpm --filter @koosani/api build

# Runtime stage: copies the entire build-stage /repo verbatim (node_modules,
# pnpm's workspace symlinks, and both packages' dist/ output) rather than
# cherry-picking paths — correctness over image size, since pnpm's symlinked
# node_modules structure is easy to subtly break by copying it partially.
FROM node:22 AS runtime

WORKDIR /repo
RUN corepack enable && corepack prepare pnpm@11.4.0 --activate
ENV NODE_ENV=production
# @koosani/shared's package.json "exports" points at ./src/*.ts by default,
# so tsx (dev mode) can run the raw TS with no separate build step. Plain
# node can't execute .ts at all, so the "production" exports condition
# (added in shared/package.json) redirects it to the compiled ./dist/*.js
# instead — opt in to that condition here, only for this runtime stage.
ENV NODE_OPTIONS=--conditions=production

COPY --from=build /repo /repo

WORKDIR /repo/api
EXPOSE 3000

RUN chmod +x docker-entrypoint.sh

# Only the `api` service uses this image's default CMD — `worker` (same
# image, docker-compose.prod.yml) overrides it with `node dist/worker.js`
# directly, so migrations/seed only ever run from one place.
ENTRYPOINT ["./docker-entrypoint.sh"]
