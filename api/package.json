{
  "name": "@koosani/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "dev:worker": "tsx watch --env-file=.env src/worker.ts",
    "worker": "tsx --env-file=.env src/worker.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx --env-file=.env src/db/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.726.1",
    "@aws-sdk/s3-request-presigner": "^3.726.1",
    "@hono/node-server": "^1.19.15",
    "@hono/zod-validator": "^0.4.3",
    "@koosani/shared": "workspace:*",
    "@react-pdf/renderer": "^4.5.1",
    "argon2": "^0.41.1",
    "bullmq": "^5.34.5",
    "cookie": "^1.0.2",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "decimal.js": "^10.4.3",
    "drizzle-orm": "^0.45.2",
    "file-type": "^22.0.1",
    "hono": "^4.13.3",
    "ioredis": "^5.4.2",
    "jsonwebtoken": "^9.0.2",
    "papaparse": "^5.4.1",
    "pdf-parse": "^1.1.1",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "postgres": "^3.4.5",
    "rate-limiter-flexible": "^5.0.3",
    "react": "^19.2.7",
    "resend": "^4.1.2",
    "sharp": "^0.35.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^10.24.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/papaparse": "^5.3.15",
    "@types/pdf-parse": "^1.1.4",
    "@types/react": "^19.2.17",
    "drizzle-kit": "^0.31.10",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.2.6"
  }
}
