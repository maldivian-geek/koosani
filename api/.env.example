NODE_ENV=development

DATABASE_URL=postgresql://koosani:koosani@localhost:5432/koosani_dev
REDIS_URL=redis://localhost:6379

# Generate: openssl rand -base64 32
JWT_SECRET=
# JWT_SECRET_PREVIOUS=

FRONTEND_URL=http://localhost:5173

# Customer portal (Phase 28) — separate secret and origin from staff auth.
# Optional: environments not running the portal can leave these unset.
PORTAL_JWT_SECRET=
PORTAL_FRONTEND_URL=http://localhost:5174

# S3-compatible object storage
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Resend (email)
RESEND_API_KEY=
RESEND_FROM=noreply@example.com

# Geo lookup: disabled | ip-api | maxmind
GEO_PROVIDER=disabled

# ClamAV daemon (SECURITY.md 13.5) - required for uploads/PDF generation.
# Dev compose maps the clamav service to host port 3311:
CLAMAV_HOST=localhost
CLAMAV_PORT=3311

# Public base URL of the api itself (local-storage signed downloads).
# Optional; defaults to http://localhost:3000.
API_PUBLIC_URL=
