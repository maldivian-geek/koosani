{
  "name": "koosani",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "pnpm -r --parallel run dev",
    "dev:api": "pnpm --filter @koosani/api dev",
    "dev:web": "pnpm --filter @koosani/web dev",
    "dev:portal": "pnpm --filter @koosani/portal dev",
    "dev:worker": "pnpm --filter @koosani/api dev:worker",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "test": "pnpm -r test",
    "prepare": "husky"
  },
  "devDependencies": {
    "eslint": "^9.39.5",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "vue-eslint-parser": "^10.4.1"
  }
}
