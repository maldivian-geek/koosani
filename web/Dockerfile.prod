# Production image for the web SPA — builds static assets with Vite and
# serves them via nginx (unlike web/Dockerfile, the dev container, which
# runs the Vite dev server directly). Build context is the repo root (pnpm
# workspace requires the full monorepo to resolve `workspace:*` deps).
FROM node:22 AS build

WORKDIR /repo
RUN corepack enable

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY api/package.json ./api/package.json
COPY web/package.json ./web/package.json
COPY portal/package.json ./portal/package.json
COPY shared/package.json ./shared/package.json

RUN pnpm install --frozen-lockfile

COPY shared ./shared
COPY web ./web

# Not `pnpm --filter @koosani/shared build` (plain `tsc -p`) — composite
# project references need `-b --force` for a from-scratch build or the
# downstream web build can't reliably resolve shared's declaration output.
RUN cd shared && pnpm exec tsc -b --force

# Vite inlines VITE_* vars into the static bundle at build time, unlike dev
# mode where they're read live — must be a build ARG, not just a runtime env
# var, or the deployed bundle will silently keep pointing at whatever URL was
# baked in last.
ARG VITE_API_URL
ENV VITE_API_URL=$VITE_API_URL
RUN pnpm --filter @koosani/web build

FROM nginx:1.27-alpine AS runtime

COPY web/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /repo/web/dist /usr/share/nginx/html

EXPOSE 80
